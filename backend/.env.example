# Variables de Entorno del Backend
PORT=3001

# Cadena de conexión para SQL Server (Prisma)
# Reemplazar con el servidor, base de datos y credenciales correspondientes
DATABASE_URL="sqlserver://localhost:1433;database=KardexDB;user=SA;password=YourPassword;encrypt=true;trustServerCertificate=true;"

# Secreto para JWT (cambiar por una clave segura en producción)
JWT_SECRET="your_jwt_secret_key_here"
